% essentials.sty — shared preamble for the ML Interview Program volumes
% Canonical copy lives in ml-interview-program/style/; volumes carry a synced copy.
% Sync with: make sync-style (from the ml-interview-program repo).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{essentials}[2026/08/27 v0.2 ML Interview Program shared style]

% Page Layout
\RequirePackage[margin=1in,inner=1.25in,outer=1in]{geometry}
\RequirePackage{fancyhdr}
\setlength{\headheight}{13.6pt}

% Math and Symbols
\RequirePackage{amsmath,amssymb,amsthm,mathtools}
\DeclareMathOperator{\softmax}{softmax}
\RequirePackage{bm}  % Bold math
\RequirePackage{dsfont} % Blackboard bold for indicators (Type 1 fonts)
\newcommand{\mR}{\mathbf{R}}
\newcommand{\mE}{\mathbf{E}}
\newcommand{\mH}{\bm{H}}
\newcommand{\mJ}{\mathbf{J}} % Jacobian matrix

% Graphics and Diagrams
\RequirePackage{tikz}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}
\usetikzlibrary{shapes,arrows,positioning,calc,fit,backgrounds,matrix,decorations.pathreplacing,patterns}

% Tables
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{multirow}
\RequirePackage{array}
\RequirePackage{colortbl}
\RequirePackage{longtable}

% Colors
\RequirePackage{xcolor}
\definecolor{deepblue}{RGB}{0,51,102}
\definecolor{deepgreen}{RGB}{0,102,51}
\definecolor{deepred}{RGB}{153,0,0}
\definecolor{lightblue}{RGB}{230,240,250}
\definecolor{lightgreen}{RGB}{230,250,230}
\definecolor{lightyellow}{RGB}{255,255,230}
\definecolor{lightgray}{RGB}{245,245,245}
\definecolor{codebg}{RGB}{248,248,248}

% Code Listings
\RequirePackage{listings}
\lstset{
    basicstyle=\ttfamily\small,
    backgroundcolor=\color{codebg},
    frame=single,
    framerule=0pt,
    breaklines=true,
    numbers=left,
    numberstyle=\tiny\color{gray},
    keywordstyle=\color{deepblue}\bfseries,
    commentstyle=\color{deepgreen}\itshape,
    stringstyle=\color{deepred},
    showstringspaces=false,
    tabsize=2
}

% Hyperlinks
\RequirePackage{hyperref}
\hypersetup{
    colorlinks=true,
    linkcolor=deepblue,
    citecolor=deepgreen,
    urlcolor=deepred
}

% Algorithms
\RequirePackage{algorithm}
\RequirePackage{algorithmic}

% Section heading styling
\RequirePackage{titlesec}
\titleformat{\chapter}[display]
  {\normalfont\huge\bfseries\sffamily\color{deepblue}}
  {\chaptertitlename\ \thechapter}{20pt}{\Huge}
\titleformat{\section}
  {\normalfont\Large\bfseries\sffamily\color{deepblue}}
  {\thesection}{1em}{}[\vspace{2pt}{\color{deepblue}\titlerule}]
\titleformat{\subsection}
  {\normalfont\large\bfseries\color{deepblue!80}}
  {\thesubsection}{1em}{}

% Misc
\RequirePackage{enumitem}
\setlist[itemize]{itemsep=2pt, parsep=2pt, topsep=4pt}
\setlist[enumerate]{itemsep=2pt, parsep=2pt, topsep=4pt}
\RequirePackage{tcolorbox}
\tcbuselibrary{theorems,skins,breakable}
\RequirePackage{float}
\RequirePackage{caption}
\RequirePackage{subcaption}

% ============================================================================
% CUSTOM THEOREM ENVIRONMENTS
% ============================================================================

\theoremstyle{definition}
\newtheorem{definition}{Definition}[section]
\newtheorem{example}{Example}[section]
\newtheorem{remark}{Remark}[section]

\theoremstyle{plain}
\newtheorem{theorem}{Theorem}[section]
\newtheorem{lemma}[theorem]{Lemma}
\newtheorem{proposition}[theorem]{Proposition}
\newtheorem{corollary}[theorem]{Corollary}

% ============================================================================
% CUSTOM BOXES
% ============================================================================

% Key Insight Box
\newtcolorbox{keyinsight}[1][Key Insight]{
    enhanced jigsaw,
    breakable,
    colback=blue!4,
    colframe=deepblue,
    colbacktitle=deepblue,
    coltitle=white,
    boxrule=0.8pt,
    arc=3pt,
    left=8pt, right=8pt, top=4pt, bottom=4pt,
    fonttitle=\bfseries\sffamily,
    title={\small #1},
    borderline west={3pt}{-4pt}{deepblue},
    pad at break*=0mm
}

% Warning Box
\newtcolorbox{warningbox}[1][]{
    enhanced jigsaw,
    breakable,
    colback=yellow!5,
    colframe=orange!80!black,
    colbacktitle=orange!80!black,
    coltitle=white,
    boxrule=0.8pt,
    arc=3pt,
    left=8pt, right=8pt, top=4pt, bottom=4pt,
    fonttitle=\bfseries\sffamily,
    title={\small Warning},
    borderline west={3pt}{-4pt}{orange!80!black},
    pad at break*=0mm,
    #1
}

% Interview Question Box
\newtcolorbox{interviewq}[1][]{
    enhanced jigsaw,
    breakable,
    colback=green!3,
    colframe=deepgreen,
    colbacktitle=deepgreen,
    coltitle=white,
    boxrule=0.8pt,
    arc=3pt,
    left=8pt, right=8pt, top=4pt, bottom=4pt,
    fonttitle=\bfseries\sffamily,
    title={\small Interview Question},
    borderline west={3pt}{-4pt}{deepgreen},
    pad at break*=0mm,
    #1
}

% TL;DR Box
\newtcolorbox{tldr}[1][]{
    enhanced jigsaw,
    breakable,
    colback=gray!5,
    colframe=gray!60,
    colbacktitle=gray!60,
    coltitle=white,
    boxrule=0.6pt,
    arc=3pt,
    left=8pt, right=8pt, top=4pt, bottom=4pt,
    fonttitle=\bfseries\sffamily,
    title={\small TL;DR},
    borderline west={3pt}{-4pt}{gray!60},
    pad at break*=0mm,
    #1
}

% Mathematical Result Box
\newtcolorbox{mathresult}[2][]{
    enhanced jigsaw,
    breakable,
    colback=white,
    colframe=deepblue,
    colbacktitle=deepblue,
    coltitle=white,
    boxrule=0.8pt,
    arc=3pt,
    left=8pt, right=8pt, top=4pt, bottom=4pt,
    fonttitle=\bfseries\sffamily,
    title={\small #2},
    pad at break*=0mm,
    #1
}

% ============================================================================
% CUSTOM COMMANDS
% ============================================================================

% Math operators
\DeclareMathOperator*{\argmax}{arg\,max}
\DeclareMathOperator*{\argmin}{arg\,min}

\DeclareMathOperator{\sigmoid}{sigmoid}
\DeclareMathOperator{\relu}{ReLU}
\DeclareMathOperator{\gelu}{GELU}
\DeclareMathOperator{\tr}{tr}
\DeclareMathOperator{\diag}{diag}
\DeclareMathOperator{\rank}{rank}
\DeclareMathOperator{\Var}{Var}
\DeclareMathOperator{\Cov}{Cov}
\DeclareMathOperator{\E}{\mathbb{E}}
\DeclareMathOperator{\KL}{KL}

% Interview question frequency markers
\newcommand{\freqhigh}{$\bigstar\bigstar\bigstar$}   % Asked constantly
\newcommand{\freqmed}{$\bigstar\bigstar\circ$}        % Common
\newcommand{\freqlow}{$\bigstar\circ\circ$}           % Occasional

% ---- Difficulty badges (colored inline tags) ----
\newtcbox{\badgeLfive}{on line, colback=blue!12, colframe=blue!40, coltext=blue!80!black,
    boxrule=0.4pt, arc=2.5pt, boxsep=0pt, left=4pt, right=4pt, top=1.5pt, bottom=1.5pt,
    fontupper=\scriptsize\bfseries\sffamily}
\newtcbox{\badgeLsix}{on line, colback=orange!12, colframe=orange!40, coltext=orange!80!black,
    boxrule=0.4pt, arc=2.5pt, boxsep=0pt, left=4pt, right=4pt, top=1.5pt, bottom=1.5pt,
    fontupper=\scriptsize\bfseries\sffamily}
\newtcbox{\badgeLseven}{on line, colback=red!12, colframe=red!40, coltext=red!80!black,
    boxrule=0.4pt, arc=2.5pt, boxsep=0pt, left=4pt, right=4pt, top=1.5pt, bottom=1.5pt,
    fontupper=\scriptsize\bfseries\sffamily}

% Type badge (neutral gray)
\newtcbox{\badgetype}{on line, colback=gray!8, colframe=gray!35, coltext=gray!70!black,
    boxrule=0.4pt, arc=2.5pt, boxsep=0pt, left=4pt, right=4pt, top=1.5pt, bottom=1.5pt,
    fontupper=\scriptsize\sffamily}

% Frequency badge (subtle)
\newtcbox{\badgefreq}{on line, colback=deepgreen!6, colframe=deepgreen!30, coltext=deepgreen!80!black,
    boxrule=0.4pt, arc=2.5pt, boxsep=0pt, left=4pt, right=4pt, top=1.5pt, bottom=1.5pt,
    fontupper=\scriptsize\sffamily}

% ---- Styled sub-headers for interview questions ----
\newcommand{\stronganswer}{\par\medskip\textcolor{deepgreen}{\sffamily\bfseries Strong answer:}\enspace}
\newcommand{\redflags}{\par\medskip\textcolor{deepred}{\sffamily\bfseries Red flags}\enspace\textcolor{deepred}{\sffamily(what NOT to say):}}
\newcommand{\interviewtest}[1]{\par\medskip\textcolor{deepblue}{\sffamily\bfseries What the interviewer is testing:}\enspace #1}
\newcommand{\goodgreat}{\par\medskip\textcolor{deepblue}{\sffamily\bfseries What separates good from great:}}
\newcommand{\followups}[1]{\par\medskip\textcolor{deepblue}{\sffamily\bfseries Common follow-ups:}\enspace #1}

